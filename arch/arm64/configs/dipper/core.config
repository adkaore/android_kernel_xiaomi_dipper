# MP v2.1 compile-test fragment over gki_defconfig; not a certified GKI build.
# Keep storage and its dependencies built in for early Android mounting.
CONFIG_ARCH_QCOM=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_PINCTRL_SDM845=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_SDM_GCC_845=y
CONFIG_INTERCONNECT_QCOM_SDM845=y
CONFIG_ARM_SMMU=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_QCOM_GENI_SE=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_MULTIPLE_DRIVERS=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QCOM_WDT=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_I2C_QCOM_CCI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_QCOM_SPMI_RRADC=m
CONFIG_CHARGER_QCOM_SMB2=m
CONFIG_REGULATOR_QCOM_LABIBB=m
CONFIG_SDM_DISPCC_845=m
CONFIG_SDM_GPUCC_845=m
CONFIG_DRM_MSM=m
CONFIG_DRM_PANEL_SAMSUNG_EA8074=m
CONFIG_PHY_QCOM_QUSB2=m
CONFIG_USB_DWC3_QCOM=m
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_ATH10K=m
CONFIG_ATH10K_SNOC=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y
CONFIG_QCOM_RMTFS_MEM=m
CONFIG_SDM_CAMCC_845=m
CONFIG_SDM_VIDEOCC_845=m
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_VIDEO_CAMERA_SENSOR=y
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_VIDEO_QCOM_VENUS=m
CONFIG_VIDEO_OV7251=m
# Compile the candidate sensor without adding an enabled camera node to the DT.
CONFIG_VIDEO_IMX363=m
# Preserve Android protections and compatibility; do not bypass VINTF/SELinux.
CONFIG_COMPAT=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_SECURITY_SELINUX=y
CONFIG_RUST=y
CONFIG_CFI=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# Required parent menus; reject silently dropped child selections.
CONFIG_PINCTRL_MSM=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_PHY_QCOM_QMP=y
# CONFIG_PHY_QCOM_QMP_COMBO is not set
# CONFIG_PHY_QCOM_QMP_PCIE is not set
# CONFIG_PHY_QCOM_QMP_PCIE_8996 is not set
# CONFIG_PHY_QCOM_QMP_USB is not set
# CONFIG_PHY_QCOM_QMP_USB_LEGACY is not set
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m

# Resident firmware only; the DT candidate remains disabled before hardware audit.
CONFIG_TOUCHSCREEN_STMFTS_FTM5=m
